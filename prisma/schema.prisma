generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  password            String
  googleId            String?  @unique
  avatar              String?
  profile             Json
  preferences         Json
  stats               Json
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  courses             Course[]
}

model Subject {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  department          String
  credits             Int
  description         String?  @db.Text
  semester            String?
  academicYear        String?
  instructor          String?
  topics              Json
  resources           Json
  prerequisites       Json
  difficulty          Int      @default(3)
  estimatedTotalHours Float    @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([department])
  @@index([isActive])
  @@index([semester])
}

model Goal {
  id                  String   @id @default(cuid())
  userId              String
  subjectId           String?
  type                String
  title               String
  description         String?  @db.Text
  targetDate          DateTime
  priority            String   @default("medium")
  difficulty          Int
  status              String   @default("not-started")
  progress            Int      @default(0)
  topics              Json
  resources           Json
  prerequisites       Json
  estimatedTotalHours Float    @default(0)
  actualHoursSpent    Float    @default(0)
  studyGroupId        String?
  isShared            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, status])
  @@index([targetDate])
  @@index([priority])
  @@index([studyGroupId])
}

model StudyPlan {
  id                  String    @id @default(cuid())
  goalId              String    @unique
  userId              String
  planVersion         Int       @default(1)
  config              Json
  sessions            Json
  milestones          Json
  aiGenerated         Boolean   @default(false)
  aiModel             String?
  generationPrompt    String?   @db.Text
  lastRegenerated     DateTime?
  regenerationReason  String?   @db.Text
  preservedSessions   Json
  totalPlannedHours   Float     @default(0)
  totalCompletedHours Float     @default(0)
  completionRate      Float     @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([planVersion])
}

model Task {
  id                String    @id @default(cuid())
  userId            String
  goalId            String
  sessionId         String?
  topicId           String?
  title             String
  description       String?   @db.Text
  type              String
  estimatedDuration Int
  difficulty        Int
  status            String    @default("not-started")
  dueDate           DateTime?
  scheduledDate     DateTime?
  scheduledTime     String?
  completed         Boolean   @default(false)
  completedAt       DateTime?
  timeSpent         Int       @default(0)
  isReview          Boolean   @default(false)
  reviewSchedule    Json?
  resources         Json
  dependsOn         Json
  linkedTasks       Json
  isManual          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
  @@index([goalId, status])
  @@index([dueDate])
  @@index([scheduledDate])
  @@index([completed])
  @@index([type])
}

model Material {
  id                String   @id @default(cuid())
  userId            String
  goalId            String
  title             String
  fileName          String?
  mimeType          String?
  sizeBytes         Int?
  source            String
  url               String?
  openaiFileId      String?
  vectorStoreId     String?
  vectorStoreFileId String?
  status            String   @default("ready")
  metadata          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, goalId])
  @@index([openaiFileId])
  @@index([vectorStoreId])
  @@index([source])
}

model StudySession {
  id               String    @id @default(cuid())
  userId           String
  goalId           String
  sessionId        String?
  title            String
  type             String
  plannedStartTime DateTime
  plannedDuration  Int
  actualStartTime  DateTime?
  actualEndTime    DateTime?
  actualDuration   Int       @default(0)
  status           String    @default("scheduled")
  tasks            Json
  notes            String?   @db.Text
  focusScore       Int       @default(0)
  pauseCount       Int       @default(0)
  totalPauseTime   Int       @default(0)
  breaks           Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([goalId])
  @@index([plannedStartTime])
}

model Progress {
  id             String   @id @default(cuid())
  userId         String
  goalId         String?
  date           DateTime
  week           Int
  month          Int
  year           Int
  plannedTime    Int      @default(0)
  actualTime     Int      @default(0)
  timeStudied    Int      @default(0)
  tasksPlanned   Int      @default(0)
  tasksCompleted Int      @default(0)
  tasksSkipped   Int      @default(0)
  completionRate Float    @default(0)
  topicMastery   Json
  currentStreak  Int      @default(0)
  burnoutScore   Float    @default(0)
  status         String   @default("on-track")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, date])
  @@index([goalId, date])
  @@index([userId, week, year])
  @@index([userId, month, year])
}

model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  ownerId     String
  members     Json
  inviteCode  String   @unique
  isPublic    Boolean  @default(false)
  sharedGoals Json
  settings    Json
  leaderboard Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([isPublic])
}

model ActivityLog {
  id                String   @id @default(cuid())
  userId            String
  type              String
  description       String   @db.Text
  relatedEntityId   String?
  relatedEntityType String?
  metadata          Json
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([relatedEntityId])
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  type              String
  title             String
  message           String    @db.Text
  actionUrl         String?
  relatedEntityId   String?
  relatedEntityType String?
  isRead            Boolean   @default(false)
  readAt            DateTime?
  scheduledFor      DateTime?
  sent              Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([userId, isRead, createdAt])
  @@index([scheduledFor, sent])
  @@index([userId, type, isRead])
}

model FixedEvent {
  id         String   @id @default(cuid())
  userId     String
  title      String
  type       String
  startTime  String
  endTime    String
  recurrence Json
  location   String?
  notes      String?  @db.Text
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, active])
  @@index([startTime, endTime])
}

model Flashcard {
  id                  String    @id @default(cuid())
  userId              String
  goalId              String
  topicId             String?
  front               String    @db.Text
  back                String    @db.Text
  difficulty          String    @default("medium")
  tags                Json
  easeFactor          Float     @default(2.5)
  interval            Int       @default(1)
  repetitions         Int       @default(0)
  lastReviewed        DateTime?
  nextReview          DateTime
  reviewCount         Int       @default(0)
  correctCount        Int       @default(0)
  incorrectCount      Int       @default(0)
  averageResponseTime Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, goalId])
  @@index([nextReview])
  @@index([userId, nextReview])
  @@index([difficulty])
}

model Course {
  id           String @id @default(cuid())
  name         String
  color        String
  difficulty   String
  progress     Int
  deadline     String
  hoursPerWeek Int

  // ❌ was String[]
  // ✅ FIX:
  goals Json

  userId String
  user   User   @relation(fields: [userId], references: [id])
}
